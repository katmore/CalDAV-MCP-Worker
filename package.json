  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deploy": "wrangler deploy -c wrangler.local.jsonc",
    "dev": "wrangler dev -c wrangler.local.jsonc",
    "start": "wrangler dev -c wrangler.local.jsonc",
    "cf-typegen": "wrangler types",
