    "tsdav": "2.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@cloudflare/workers-types": "5.20261021.1",
    "@vitest/coverage-istanbul": "4.1.12",
    "typescript": "6.0.3",
