    "vendor:check": "node scripts/vendor.mjs check",
    "vendor:update": "node scripts/vendor.mjs update",
    "vendor:verify": "node scripts/vendor.mjs verify"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.8.3",
    "agents": "0.29.0",
    "hono": "4.13.13",
    "ical.js": "2.2.1",
    "just-pick": "4.2.0",
    "octokit": "5.0.5",
    "tsdav": "2.5.0",
    "zod": "4.6.7",
    "@modelcontextprotocol/server": "2.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.151.3"
  },
  "license": "MIT"
}
